{
  "name": "tempo-earcheck",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:claims": "playwright test tests/claims.spec.ts --project=chromium",
    "test:live": "node scripts/verify-live.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
